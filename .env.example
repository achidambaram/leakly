# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# AgentMail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=your_inbox@agentmail.to

# Google Gemini
GEMINI_API_KEY=

# Supermemory
SUPERMEMORY_API_KEY=

# Sponge (USDC payments)
SPONGE_ENABLED=true
SPONGE_API_KEY=
SPONGE_CHAIN=solana
SPONGE_DEFAULT_VENDOR_WALLET=

# Stripe (optional — falls back to mock if not set)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Browser Use (optional — enables vendor portal booking)
BROWSER_USE_API_KEY=

# App
PORT=3001
NODE_ENV=development
DEMO_PAYMENT_AMOUNT=0.50
